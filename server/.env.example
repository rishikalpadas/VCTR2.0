# Node API
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Where the Python vectorization service is listening.
# Point this at another host to run the engine on a separate machine.
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# Vectorizing a large detailed image on CPU is genuinely slow.
# Keep this comfortably above the worst realistic case (ms).
PYTHON_TIMEOUT_MS=120000
PYTHON_HEALTH_TIMEOUT_MS=4000

# 15 MB
MAX_UPLOAD_BYTES=15728640

# Keep a copy of every generated SVG in server/outputs/.
# Off by default: the POC returns the SVG inline and should not retain uploads.
PERSIST_OUTPUTS=false
