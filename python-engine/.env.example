# Copy to .env to override. All variables use the VEC_ prefix.

VEC_HOST=127.0.0.1
VEC_PORT=8000
VEC_LOG_LEVEL=INFO

# 15 MB upload ceiling
VEC_MAX_UPLOAD_BYTES=15728640

# Reject images above 40 megapixels (decompression-bomb guard)
VEC_MAX_INPUT_PIXELS=40000000

# Hard ceiling on the longest edge fed to the tracer, applied after the
# preset's own max_dimension. Raising this increases fidelity, path count,
# CPU time and output size.
VEC_ABSOLUTE_MAX_DIMENSION=2600
